# Doomsday Clock V2 configuration template
#
# Copy this file to `.env.local` for local development. Keep every value blank
# until the matching integration is intentionally configured. Never put a real
# secret in this example or in a NEXT_PUBLIC_* variable.
#
# Classification:
#   PUBLIC       Intentionally shipped to the browser.
#   SERVER       Non-secret server/deployment configuration; do not expose by default.
#   SECRET       Server/deployment secret; never ship to the browser or commit.
#   DASHBOARD    Configure at the provider; it does not belong in this file.
#   SESSION-ONLY Entered by an end user at runtime and held in memory; not an env var.

# Application origins
# PUBLIC: canonical URL shown in links and redirects.
NEXT_PUBLIC_APP_URL=
# SERVER: one exact canonical origin (scheme + host + optional port).
APP_ORIGIN=
# SERVER: comma-separated exact origins. Never use `*` with credentials.
ALLOWED_ORIGINS=
# SERVER: exact origins allowed to call the session-only AI relay.
AI_ALLOWED_ORIGINS=

# Clerk authentication
# PUBLIC: Clerk publishable key (pk_test_... locally, pk_live_... in production).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# SECRET: Clerk Backend API secret key. Never prefix with NEXT_PUBLIC_.
CLERK_SECRET_KEY=
# SERVER: exact comma-separated origins accepted in Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=
# SECRET: optional webhook signing secret for verified Clerk webhooks.
CLERK_WEBHOOK_SIGNING_SECRET=
# DASHBOARD: Google OAuth client ID and client secret are entered in Clerk's
# production Google connection. Do not copy the Google client secret here.

# Cloudflare and D1
# SERVER: Cloudflare account and D1 identifiers are operational metadata, not
# authentication. The application should access D1 through a runtime binding.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_BINDING_NAME=DB
# SECRET: deployment/control-plane token with only the permissions required.
CLOUDFLARE_API_TOKEN=

# here.now publishing
# SECRET: publish credential only. Prefer ~/.herenow/credentials for local use.
# This key must never become a runtime browser variable.
HERENOW_API_KEY=

# Optional app-owned AI accounts
# SECRET: server-owned provider keys. Leave blank to keep app-owned AI disabled.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# SESSION-ONLY: an end user's OpenAI or Anthropic BYOK key is entered in the UI,
# held only in JavaScript memory, relayed without logging, and cleared on refresh,
# sign-out, provider change, disconnect, or tab close. It never belongs here.
# SESSION-ONLY: Ollama and LM Studio use a small, fixed allowlist of loopback
# endpoints and connect only after an explicit test. The app never scans ports.

# YouTube (first music adapter)
# No credential is required for approved public YouTube IFrame embeds.
# SECRET: optional server-side YouTube Data API key for future catalog/search.
YOUTUBE_DATA_API_KEY=
# PUBLIC: optional OAuth client ID for future user-authorized YouTube data.
NEXT_PUBLIC_YOUTUBE_OAUTH_CLIENT_ID=
# SECRET: optional OAuth client secret; never required by an IFrame embed.
YOUTUBE_OAUTH_CLIENT_SECRET=
# SERVER: exact callback registered in Google Cloud for a future OAuth flow.
YOUTUBE_OAUTH_REDIRECT_URI=

# Spotify (adapter remains unavailable until implemented and verified)
# PUBLIC: Spotify application client ID.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# SECRET: only for a server-side authorization-code exchange. A browser PKCE
# flow must not receive or use this secret.
SPOTIFY_CLIENT_SECRET=
# SERVER: exact HTTPS callback (or an explicit loopback IP during local work).
SPOTIFY_REDIRECT_URI=

# Apple Music (adapter remains unavailable until implemented and verified)
# SERVER: Apple developer identifiers used to sign a short-lived developer token.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_MEDIA_ID=
# SECRET: contents of the MusicKit private .p8 key supplied through the hosting
# secret store. Never commit a .p8 file or expose this value to the browser.
APPLE_MUSIC_PRIVATE_KEY=

# Optional accountability support destination
# PUBLIC: your creator page, for example https://buymeacoffee.com/yourname.
# This is a public link, not an API key or payment credential.
NEXT_PUBLIC_BUYMEACOFFEE_URL=

# Optional Cloudflare Turnstile
# PUBLIC: widget site key, restricted to approved hostnames in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET: server-side token-verification key.
TURNSTILE_SECRET_KEY=
